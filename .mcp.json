{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "hostinger-hosting": {
      "command": "npx",
      "args": [
        "--package=hostinger-api-mcp@latest",
        "hostinger-hosting-mcp"
      ]
    },
    "hostinger-domains": {
      "command": "npx",
      "args": [
        "--package=hostinger-api-mcp@latest",
        "hostinger-domains-mcp"
      ]
    },
    "hostinger-dns": {
      "command": "npx",
      "args": [
        "--package=hostinger-api-mcp@latest",
        "hostinger-dns-mcp"
      ]
    },
    "hostinger-billing": {
      "command": "npx",
      "args": [
        "--package=hostinger-api-mcp@latest",
        "hostinger-billing-mcp"
      ]
    }
  }
}
